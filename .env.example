# Salin file ini jadi .env lalu sesuaikan
SERVER_HOST=WanderLands.aternos.me
SERVER_PORT=19132
BOT_USERNAME=BotServer

# true  = server offline-mode (online-mode=false di server.properties)
# false = login akun Microsoft (kode login muncul di console)
OFFLINE=false

# Opsional: kunci versi, contoh 1.21.50 (kosongkan = auto)
MC_VERSION=

COMMAND_PREFIX=!
# Nama pemain yang boleh pakai perintah admin, pisah koma
ADMINS=
WELCOME_MESSAGE=Bot aktif! Ketik !help untuk daftar perintah.

# Anti-AFK: ayun tangan tiap N detik (0 = mati)
ANTI_AFK_SECONDS=30
RECONNECT_DELAY_SECONDS=5
RECONNECT_MAX_DELAY_SECONDS=60
